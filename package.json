{
  "name": "switchwize-mcp",
  "version": "0.3.0",
  "description": "Credentials-free stdio bridge to SwitchWize public read-only MCP tools, prompts and resources.",
  "type": "module",
  "bin": {
    "switchwize-mcp": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "verify:package": "npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run verify:package",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "verify:live": "npm run build && node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "switchwize",
    "finance",
    "rates",
    "savings",
    "cd-rates"
  ],
  "homepage": "https://www.switchwize.com/developers",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/switchwize/switchwize-mcp.git"
  },
  "mcpName": "io.github.switchwize/switchwize-mcp"
}
